# Copy to .env.local for `npm run dev`. The Compose stack sets these for itself.
# Server side only. Nothing here reaches a browser.
API_URL=http://127.0.0.1:8000
APP_ORIGIN=http://localhost:3000
# What browsers are sent to, and what the server calls. On Compose the second one is http://keycloak:8080/...
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/samvid
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8080/realms/samvid
KEYCLOAK_CLIENT_ID=samvid-web
# WEB_SESSION_SECRET from infra/.env
SESSION_SECRET=
# Only for plain http on your own machine.
SESSION_COOKIE_SECURE=false
