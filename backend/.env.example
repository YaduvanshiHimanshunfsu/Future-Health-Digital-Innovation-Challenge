# For running the API outside Docker. Inside Docker, infra/docker-compose.yml sets all of this.
# Generate real values with: python scripts/generate_env.py
# Never commit a real .env.
ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://samvid_app:CHANGE_ME@127.0.0.1:5432/samvid
MIGRATION_DATABASE_URL=postgresql+asyncpg://samvid_owner:CHANGE_ME@127.0.0.1:5432/samvid
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000
SUPPORTED_LANGUAGES=en,ar,hi
DEFAULT_LANGUAGE=en

# The issuer must match the `iss` claim Keycloak writes, however the API reaches Keycloak.
OIDC_ISSUER=http://localhost:8080/realms/samvid
OIDC_AUDIENCE=samvid-api
OIDC_JWKS_URL=http://localhost:8080/realms/samvid/protocol/openid-connect/certs

OPENFGA_API_URL=http://127.0.0.1:8081

KMS_PROVIDER=local
# Dev only, and refused when ENV=prod. Each of these is 32 random bytes in base64.
LOCAL_KEK_B64=
AUDIT_HMAC_KEY=
INVITE_HMAC_KEY=
NATIONAL_ID_HMAC_KEY=
ANALYTICS_HMAC_KEY=

LLM_PROVIDER=template
