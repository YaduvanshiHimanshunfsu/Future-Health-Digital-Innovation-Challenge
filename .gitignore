# Secrets: never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Real data must never enter this repo. Synthetic output is generated.
backend/synthetic/out/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# Node and Next.js. The directory names here are anchored on purpose: a bare
# `out/` or `coverage/` matches at every depth and would hide a source package
# that happens to share the name.
node_modules/
.next/
/frontend/out/
/frontend/coverage/
/backend/coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Downloaded model weights and tool caches. Anchored to the repository root:
# an unanchored `models/` also matched `backend/app/models/`, the SQLAlchemy
# package, and kept the whole ORM layer out of every clone. See brain.md #022.
/models/
.cache/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Design tool export: holds text the project mustn't publish. See frontend/design-export/README.md.
/stitch_*.zip
frontend/test-results/
frontend/playwright-report/

# The launcher writes one log per run. Secrets are redacted, but these are local anyway.
/logs/
